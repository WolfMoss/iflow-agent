# iFlow CLI WebSocket（手动模式）；端口与下方自动启动一致
IFLOW_WS_URL=ws://localhost:8090/acp
# 启动网关时是否自动启动 iFlow 进程；设为 false 则需手动先运行 iflow --experimental-acp --port 8090
IFLOW_AUTO_START=true
# 默认工作区目录名，位于用户目录下（Win: %USERPROFILE%，Linux: $HOME）；启动时自动创建
# IFLOW_WORKSPACE_DIR_NAME=.iflowagentworkspace

# Server
HOST=0.0.0.0
PORT=8000

# Session (optional: Redis URL for multi-instance; leave empty for in-memory)
# SESSION_STORE_URL=

# Log level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# Telegram（可选）
# 从 @BotFather 获取 Bot Token；配置后本地直接运行即可，无需服务器/域名（Long Polling）
# TELEGRAM_BOT_TOKEN=
# 允许对话的用户 ID，逗号分隔；* 或 ALL 表示允许所有人
# TELEGRAM_ALLOW_FROM=*
# 仅当部署到公网并配置了 Webhook 时设为 true，此时不启动 Long Polling
# TELEGRAM_USE_WEBHOOK=false
# 连接 Telegram API 超时秒数（默认 60）；若出现 ConnectTimeout 可调大或配置代理
# TELEGRAM_TIMEOUT=60
# 请求 Telegram 的代理 URL（国内等网络受限时可设，如 http://127.0.0.1:7890）
# TELEGRAM_PROXY=

# QQ（可选，腾讯官方机器人平台 botpy）
# QQ_APP_ID=
# QQ_APP_SECRET=
# QQ_SANDBOX=true
